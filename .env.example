# --- Supabase (tarayıcıda görünür, gizli değildir; güvenlik RLS kurallarıyla sağlanır) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Sipariş yönlendirmesi ---
# Uluslararası biçim, başında + ya da 00 olmadan
VITE_WHATSAPP_NUMBER=905056327323

# --- Site adresi (paylaşım görselleri ve site haritası için) ---
VITE_SITE_URL=https://didihome.store

# --- Otomatik çeviri (YALNIZCA sunucu tarafı; tarayıcıya asla gönderilmez) ---
# Vercel → Settings → Environment Variables altına eklenir, bu dosyaya yazılmaz.
OPENROUTER_API_KEY=
# openrouter.ai/models sayfasındaki model kimliği (boş bırakılırsa: anthropic/claude-sonnet-4)
OPENROUTER_MODEL=
